generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Expense {
  id               String   @id @default(cuid())
  title            String
  amount           Float
  currency         String   @default("IDR")
  originalAmount   Float?
  originalCurrency String?
  category         String
  date             DateTime
  notes            String?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptId        String?
  receipt          Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  source           String   @default("MANUAL") // MANUAL, AI, RECEIPT
  type             String   @default("EXPENSE") // INCOME, EXPENSE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@index([receiptId])
}

model Receipt {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     String?
  date      DateTime?
  total     Float?
  status    String    @default("PROCESSED") // PENDING, PROCESSED, FAILED
  imageUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]

  @@index([userId])
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String @default("IDR")
  theme    String @default("system")
  language String @default("en")
  timezone String @default("UTC")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // ALERT, SUCCESS, INFO, WARNING
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType  String // FIRST_EXPENSE, UNDER_BUDGET, etc.
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeType])
  @@index([userId])
}

// ==========================================
// VERSION 6: ENTERPRISE ADMIN & RBAC MODELS
// ==========================================

model User {
  id        String   @id // Matches Supabase Auth UUID
  email     String   @unique
  name      String?
  username  String?  @unique
  avatarUrl String?
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses      Expense[]
  receipts      Receipt[]
  settings      UserSettings?
  notifications Notification[]
  achievements  Achievement[]
  activityLogs  ActivityLog[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  feedbacks     Feedback[]
  products      Product[]
  orders        Order[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  String?  @db.Text // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. "USER_SUSPENDED", "PROMPT_UPDATED"
  details   String? // JSON string or plain text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String
  active     Boolean   @default(true)
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  content   String
  category  String // BUG, FEATURE, OTHER
  status    String   @default("OPEN") // OPEN, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model AIPrompt {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "RECEIPT_EXTRACTOR", "BUDGET_COACH"
  prompt      String   @db.Text
  version     Int      @default(1)
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// WA COMMERCE MODELS
// ==========================================

model Product {
  id          String   @id @default(cuid())
  userId      String   
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@index([userId])
}

model Order {
  id            String   @id @default(cuid())
  userId        String   
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerPhone String   
  customerName  String?
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, CANCELED
  paymentLink   String?
  paymentId     String?  // Midtrans transaction ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]

  @@index([userId])
  @@index([customerPhone])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float    // Snapshot of price at time of order

  @@index([orderId])
  @@index([productId])
}
